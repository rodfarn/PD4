        <mxCell id="nota" value="PK = clave primaria · FK = clave foránea · UNIQUE = valor único&lt;br&gt;stand_id es UNIQUE, por eso un stand aparece como máximo en una reserva." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#f5f5f5;strokeColor=#999999;fontSize=13;" vertex="1" parent="1"><mxGeometry x="360" y="560" width="900" height="80" as="geometry" /></mxCell>
